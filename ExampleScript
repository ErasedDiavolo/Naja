local ReadmeText = table.concat({
    "# NaJa UI Library - Complete Documentation",
    "",
    "## What is NaJa UI?",
    "NaJa UI is a modern, feature-rich UI library for Roblox executors. It is built for script hubs, configuration panels, and utility menus. It provides a polished dark theme with smooth animations, glassmorphism effects, and extensive customization options.",
    "",
    "## Loading the Library",
    "Place this at the very top of your script:",
    "```lua",
    "local Library = loadstring(game:HttpGet(\"https://raw.githubusercontent.com/ErasedDiavolo/Naja/refs/heads/main/Nja\"))()",
    "```",
    "",
    "## Creating a Window",
    "The window is the root container for your entire interface.",
    "```lua",
    "local Window = Library:NaJa({",
    "    Title = \"My Script Hub\",",
    "    Desc = \"v1.0.0\",",
    "    Bind = Enum.KeyCode.RightShift,",
    "    Discord = \"https://discord.gg/example\"",
    "})",
    "```",
    "",
    "| Property | Type | Description |",
    "|----------|------|-------------|",
    "| Title | string | The window title text |",
    "| Desc | string | Subtitle or version label |",
    "| Bind | Enum.KeyCode | Key used to toggle UI visibility |",
    "| Discord | string | Discord invite link (optional) |",
    "",
    "## Creating Tabs",
    "Tabs separate your features into categories. The second argument is a Lucide icon name.",
    "```lua",
    "local MainTab = Window:Tab(\"Main\", \"layout-dashboard\")",
    "local CombatTab = Window:Tab(\"Combat\", \"sword\")",
    "local VisualsTab = Window:Tab(\"Visuals\", \"eye\")",
    "local SettingsTab = Window:Tab(\"Settings\", \"settings\")",
    "```",
    "",
    "Common Lucide icons for tabs:",
    "- `layout-dashboard` - Main / Dashboard",
    "- `sword` - Combat",
    "- `eye` - Visuals / ESP",
    "- `zap` - Movement",
    "- `settings` - Settings",
    "- `book-open` - Info / Docs",
    "- `book-text` - Readme",
    "- `sliders-horizontal` - Sliders",
    "- `mouse-pointer-click` - Interactive",
    "- `flask-conical` - Experiment / Misc",
    "- `text-cursor-input` - Inputs",
    "- `chevrons-up-down` - Dropdowns",
    "- `wallpaper` - Background",
    "",
    "## Creating Sections",
    "Sections organize elements inside tabs. Use `Left` and `Right` to create two columns.",
    "```lua",
    "local LeftSection = MainTab:Section(\"Features\", \"Left\")",
    "local RightSection = MainTab:Section(\"Settings\", \"Right\")",
    "```",
    "",
    "## Elements Reference",
    "",
    "### Button",
    "Triggers a callback immediately when clicked.",
    "```lua",
    "Section:Button(\"Click Me\", function()",
    "    print(\"Button was clicked!\")",
    "end)",
    "```",
    "",
    "### Toggle",
    "A smooth sliding on/off switch. Returns `true` or `false`.",
    "```lua",
    "Section:Toggle(\"Auto Farm\", false, function(state)",
    "    print(\"Auto Farm is now:\", state)",
    "end)",
    "```",
    "",
    "### Checkbox",
    "A checkmark-style toggle. Same functionality as Toggle but with a different visual.",
    "```lua",
    "Section:Checkbox(\"ESP Enabled\", false, function(state)",
    "    print(\"ESP:\", state)",
    "end)",
    "```",
    "",
    "### Slider",
    "Numeric value selector. Set the second argument to `true` for decimal/float values.",
    "```lua",
    "-- Integer slider (whole numbers)",
    "Section:Slider(\"Walk Speed\", false, 16, 500, 16, function(value)",
    "    game.Players.LocalPlayer.Character.Humanoid.WalkSpeed = value",
    "end)",
    "",
    "-- Float slider (decimal values)",
    "Section:Slider(\"Field of View\", true, 30, 120, 70, function(value)",
    "    workspace.CurrentCamera.FieldOfView = value",
    "end)",
    "```",
    "",
    "### Dropdown (Single Select)",
    "Select one item from a list.",
    "```lua",
    "Section:Dropdown(\"Select Weapon\", {\"Sword\", \"Axe\", \"Bow\", \"Staff\"}, \"Sword\", function(selected)",
    "    print(\"You selected:\", selected)",
    "end)",
    "```",
    "",
    "Add `true` as the last argument to enable real-time search:",
    "```lua",
    "Section:Dropdown(\"Search Items\", {\"Health\", \"Mana\", \"Stamina\", \"Speed\"}, \"Health\", function(selected)",
    "    print(selected)",
    "end, true)",
    "```",
    "",
    "### Multi Dropdown",
    "Select multiple items at once. Returns a table of selected items.",
    "```lua",
    "Section:MultiDropdown(\"Select Buffs\", {\"Speed\", \"Jump\", \"God Mode\"}, {\"Speed\"}, function(selectedList, changedItem)",
    "    print(\"Selected:\", table.concat(selectedList, \", \"))",
    "end)",
    "```",
    "",
    "### DropdownV2 / MultiDropdownV2",
    "Floating panel versions. Better for long lists because they do not expand inside the section.",
    "```lua",
    "Section:DropdownV2(\"Weapon V2\", {\"Sword\", \"Axe\", \"Bow\", \"Staff\", \"Dagger\"}, \"Sword\", function(selected)",
    "    print(selected)",
    "end)",
    "",
    "Section:MultiDropdownV2(\"Buffs V2\", {\"Speed\", \"Jump\", \"God\"}, {\"Speed\"}, function(list, item)",
    "    print(table.concat(list, \", \"))",
    "end)",
    "```",
    "",
    "### InputSmall",
    "Single-line text input. Press Enter to submit.",
    "```lua",
    "Section:InputSmall(\"Username\", \"Enter username...\", function(text)",
    "    print(\"Username:\", text)",
    "end)",
    "```",
    "",
    "### InputLarge",
    "Multi-line text area for longer content.",
    "```lua",
    "Section:InputLarge(\"Description\", \"Enter details here...\", function(text)",
    "    print(\"Received\", #text, \"characters\")",
    "end)",
    "```",
    "",
    "### Textbox",
    "Classic labeled input field with a title above it.",
    "```lua",
    "Section:Textbox(\"Webhook URL\", \"https://discord.com/api/webhooks/...\", function(text)",
    "    print(\"Webhook set to:\", text)",
    "end)",
    "```",
    "",
    "### Label / LabelColor",
    "Plain text display. Use LabelColor for colored text.",
    "```lua",
    "Section:Label(\"This is normal text\")",
    "Section:LabelColor(\"This is red text\", Color3.fromRGB(255, 100, 100))",
    "```",
    "",
    "### Paragraph",
    "Wrapped multi-line text. Perfect for descriptions and changelogs.",
    "```lua",
    "Section:Paragraph(\"This is a long description that automatically wraps inside the section panel. Resize the window to see it reflow!\", Color3.fromRGB(140, 140, 140))",
    "```",
    "",
    "### AnimatedParagraph",
    "Types text out character by character.",
    "```lua",
    "-- Single message",
    "Section:AnimatedParagraph(\"This text types itself out when you open the tab!\", 0.04, Color3.fromRGB(200, 200, 200))",
    "",
    "-- Multiple messages (pass a table)",
    "Section:AnimatedParagraph({",
    "    \"First message...\",",
    "    \"Second message...\",",
    "    \"Third message...\"",
    "}, 0.04, Color3.fromRGB(100, 200, 255))",
    "",
    "-- Looping (types, erases, and repeats forever)",
    "Section:AnimatedParagraph(\"This loops infinitely!\", 0.035, Color3.fromRGB(255, 180, 80), true)",
    "```",
    "",
    "### Keybind",
    "Captures a keyboard key and triggers a callback when pressed.",
    "```lua",
    "Section:Keybind(\"Fly Key\", Enum.KeyCode.F, function(key)",
    "    print(\"Activated with key:\", key.Name)",
    "end)",
    "```",
    "",
    "### Image",
    "Displays an image with an optional zoom lightbox. Click the image to zoom.",
    "```lua",
    "Section:Image({",
    "    Name = \"Showcase Image\",",
    "    Image = \"rbxassetid://6317221408\",",
    "    Height = 160,",
    "    CornerRadius = 10,",
    "    Border = true,",
    "    BorderColor = Color3.fromRGB(40, 40, 40),",
    "    BorderThickness = 1,",
    "    ScaleType = Enum.ScaleType.Fit,",
    "    Callback = function()",
    "        print(\"Image was clicked!\")",
    "    end",
    "})",
    "```",
    "",
    "### Video",
    "Video player with playback controls.",
    "```lua",
    "Section:Video({",
    "    Name = \"Showcase Video\",",
    "    Video = \"rbxassetid://5608290551\",",
    "    Height = 160,",
    "    CornerRadius = 10,",
    "    Border = true,",
    "    BorderColor = Color3.fromRGB(40, 40, 40),",
    "    BorderThickness = 1,",
    "    Looped = true,",
    "    Playing = true,",
    "    Volume = 0.5,",
    "    Callback = function()",
    "        print(\"Video clicked!\")",
    "    end",
    "})",
    "```",
    "",
    "### ProfileCard",
    "A banner card with a profile picture, name, description, and action buttons.",
    "```lua",
    "Tab:ProfileCard({",
    "    Banner = \"rbxassetid://91070444331154\",",
    "    BannerHeight = 120,",
    "    Pfp = \"rbxassetid://6317221408\",",
    "    Name = \"My Script Hub\",",
    "    Description = \"The best hub for this game!\",",
    "    Buttons = {",
    "        {",
    "            Text = \"GitHub\",",
    "            Color = Color3.fromRGB(88, 101, 242),",
    "            HoverColor = Color3.fromRGB(110, 125, 255),",
    "            StrokeColor = Color3.fromRGB(100, 115, 255),",
    "            HoverStrokeColor = Color3.fromRGB(130, 145, 255),",
    "            TextColor = Color3.fromRGB(255, 255, 255),",
    "            Callback = function()",
    "                print(\"GitHub button clicked!\")",
    "            end",
    "        },",
    "        {",
    "            Text = \"Discord\",",
    "            Color = Color3.fromRGB(35, 35, 35),",
    "            HoverColor = Color3.fromRGB(50, 50, 50),",
    "            StrokeColor = Color3.fromRGB(55, 55, 55),",
    "            HoverStrokeColor = Color3.fromRGB(75, 75, 75),",
    "            TextColor = Color3.fromRGB(200, 200, 200),",
    "            Callback = function()",
    "                print(\"Discord button clicked!\")",
    "            end",
    "        }",
    "    }",
    "})",
    "```",
    "",
    "### Description (Custom Documentation Block)",
    "This is the element you are reading right now. It supports headers, tables, and code blocks.",
    "```lua",
    "local MyDocs = table.concat({",
    "    \"# My Header\",",
    "    \"Some explanation text here.\",",
    "    \"```lua\",",
    "    \"print('This is a code block')\",",
    "    \"```\"",
    "}, \"\\n\")",
    "",
    "Tab:Description({",
    "    Title = \"My Documentation\",",
    "    Text = MyDocs",
    "})",
    "```",
    "",
    "### Separator",
    "Divides content with a styled line and title.",
    "```lua",
    "Section:Seperator(\"Advanced Settings\")",
    "```",
    "",
    "## Tab Background Image",
    "Set a background image behind a tab. Sections will use a frosted glass effect over it.",
    "```lua",
    "local BgTab = Window:Tab(\"Background\", \"wallpaper\")",
    "BgTab:SetTabImage(\"rbxassetid://6317221408\", 0.15, Color3.fromRGB(200, 200, 255))",
    "```",
    "",
    "## API Methods (Updating Elements)",
    "Most elements return an object that you can update dynamically after creation.",
    "",
    "| Method | Works On | Description |",
    "|--------|----------|-------------|",
    "| :Set(text) | Label, Paragraph, AnimatedParagraph | Updates the displayed text |",
    "| :Update(state) | Toggle, Checkbox | Programmatically changes on/off state |",
    "| :SetText(text) | Most elements | Changes the element's label/title |",
    "| :Set(value) | Slider | Moves the slider to a new value |",
    "| :Set(value, silent) | Dropdown | Selects an item (silent skips callback) |",
    "| :Get() | Dropdown | Returns the currently selected value(s) |",
    "| :Add(item) | Dropdown | Appends a new option to the list |",
    "| :Clear() | Dropdown | Removes all options from the list |",
    "| :SetImage(id) | Image | Swaps the image |",
    "| :SetHeight(px) | Image | Changes the image height |",
    "| :OpenZoom() / :CloseZoom() | Image | Controls the zoom lightbox |",
    "| :SetLoop(boolean) | AnimatedParagraph | Enables or disables infinite looping |",
    "| :SetBanner(id) | ProfileCard | Changes the banner image |",
    "| :SetPfp(id) | ProfileCard | Changes the profile picture |",
    "| :SetName(text) | ProfileCard | Changes the card title |",
    "| :SetDescription(text) | ProfileCard | Changes the card description |",
    "| :UpdateButtonText(idx, text) | ProfileCard | Changes a button's label |",
    "| :SetButtonColor(idx, color) | ProfileCard | Changes a button's color |",
    "",
    "## Notifications",
    "Send toast notifications from anywhere after the window is created.",
    "```lua",
    "-- Basic notification (title, message, duration in seconds)",
    "Window:Notify(\"Success\", \"Feature enabled!\", 3)",
    "",
    "-- Notification with a sound effect",
    "Window:Notify(\"Alert\", \"Something happened!\", 4, 9122054151)",
    "```",
    "",
    "## Built-in Settings Panel",
    "NaJa UI automatically adds a settings gear icon in the window's top bar. Users can toggle:",
    "- Notifications on/off",
    "- UI sounds on/off",
    "- Global text color",
    "- UI transparency",
    "- UI size / scale",
    "- Window toggle keybind",
    "- Element search",
    "- Clean UI destruction",
    "",
    "## Best Practices",
    "1. Keep tab titles short (one or two words)",
    "2. Group related controls together in the same section",
    "3. Balance content between `Left` and `Right` sections",
    "4. Use `Paragraph` for long text, `Label` for short text",
    "5. Use `AnimatedParagraph` only on intro or info tabs (not on main controls)",
    "6. Use `DropdownV2` when you have more than 6 items",
    "7. Enable search on dropdowns with 8 or more items",
    "8. Set reasonable min/max values on sliders",
    "9. Use consistent naming conventions across all tabs",
    "10. Use `Description` for large documentation blocks instead of many small Labels",
    "",
    "## Full Working Example",
    "```lua",
    "local Library = loadstring(game:HttpGet(\"https://raw.githubusercontent.com/ErasedDiavolo/Naja/refs/heads/main/Nja\"))()",
    "",
    "local Window = Library:NaJa({",
    "    Title = \"My Script\",",
    "    Desc = \"v1.0\",",
    "    Bind = Enum.KeyCode.RightShift,",
    "})",
    "",
    "local MainTab = Window:Tab(\"Main\", \"layout-dashboard\")",
    "local Section = MainTab:Section(\"Features\", \"Left\")",
    "",
    "Section:Toggle(\"Auto Farm\", false, function(state)",
    "    print(\"Auto Farm:\", state)",
    "end)",
    "",
    "Section:Slider(\"Speed\", false, 16, 100, 16, function(val)",
    "    game.Players.LocalPlayer.Character.Humanoid.WalkSpeed = val",
    "end)",
    "",
    "Section:Dropdown(\"Mode\", {\"Easy\", \"Normal\", \"Hard\"}, \"Normal\", function(mode)",
    "    print(\"Mode:\", mode)",
    "end)",
    "",
    "Section:Button(\"Kill Aura\", function()",
    "    print(\"Kill Aura activated!\")",
    "end)",
    "```",
    "",
    "## Troubleshooting",
    "",
    "**UI does not appear:**",
    "Verify the loadstring URL is correct and your executor supports `game:HttpGet`.",
    "",
    "**Text looks cut off:**",
    "Use `Paragraph` instead of `Label` for long strings, or increase the window size.",
    "",
    "**Tabs feel crowded:**",
    "Split content into more tabs or use additional Left/Right sections.",
    "",
    "**Animations look strange:**",
    "Keep timing consistent. Use 0.03-0.05 for typing effects and 0.2-0.5 for UI transitions.",
    "",
    "**String errors in code blocks:**",
    "For long multi-line strings, use `table.concat` with `\\n` separators, or wrap the string in `[[` and `]]`.",
    "",
    "## Credits",
    "NaJa UI Library by ErasedDiavolo",
    "Icons powered by Lucide"
}, "\n")

